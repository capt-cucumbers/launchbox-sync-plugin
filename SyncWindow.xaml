<lbThemeControls:ThemedWindow x:Class="LaunchBoxSyncPlugin.SyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lbTheme="clr-namespace:Unbroken.LaunchBox.Windows.Desktop.DialogTheming;assembly=LaunchBox"
        xmlns:lbThemeControls="clr-namespace:Unbroken.LaunchBox.Windows.Desktop.DialogTheming.Controls;assembly=LaunchBox"
        Title="Sync External Games" Height="520" Width="720"
        Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type lbTheme:Brushes}, ResourceId=Layer0BackgroundBrush}}"
        Foreground="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type lbTheme:Brushes}, ResourceId=ForegroundBrush}}"
        FontFamily="Segoe UI" FontSize="12"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/LaunchBox;component/dialogtheming/colorschemes/common.xaml" />
                <ResourceDictionary Source="pack://application:,,,/LaunchBox;component/dialogtheming/customtheme/dimensions.xaml" />
                <ResourceDictionary Source="pack://application:,,,/LaunchBox;component/dialogtheming/customtheme/defaultstyles/window.xaml" />
                <ResourceDictionary Source="pack://application:,,,/LaunchBox;component/dialogtheming/customtheme/defaultstyles/button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/LaunchBox;component/dialogtheming/customtheme/defaultstyles/listbox.xaml" />
                <ResourceDictionary Source="pack://application:,,,/LaunchBox;component/dialogtheming/customtheme/defaultstyles/scrollbar.xaml" />
                <ResourceDictionary Source="pack://application:,,,/LaunchBox;component/dialogtheming/customtheme/namedstyles/accentbutton.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20,15,20,15">
        <Grid.RowDefinitions>
            <!-- Header Information -->
            <RowDefinition Height="Auto"/>
            <!-- Spacer -->
            <RowDefinition Height="15"/>
            <!-- Storefront Rows List -->
            <RowDefinition Height="*"/>
            <!-- Spacer -->
            <RowDefinition Height="15"/>
            <!-- Bottom Action Panel -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Manage External Game Sync" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type lbTheme:Brushes}, ResourceId=ForegroundBrush}}"/>
                <TextBlock Text="Synchronize externally managed games with LaunchBox" FontSize="12" Margin="0,3,0,0" Foreground="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type lbTheme:Brushes}, ResourceId=ForegroundBrush}}" Opacity="0.7" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- Main Content: Storefronts List -->
        <ListBox Name="LstSources" Grid.Row="2" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type lbTheme:Brushes}, ResourceId=Layer1BackgroundBrush}}"
                            BorderBrush="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type lbTheme:Brushes}, ResourceId=Layer2BorderBrush}}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="15,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Storefront Info -->
                                <ColumnDefinition Width="*"/>
                                <!-- Sync Dropdown and Button -->
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Storefront Name -->
                            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" ToolTip="{Binding ValidationError}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Dot indicator -->
                                    <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#FF3B30"/> <!-- Default Red -->
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsValid}" Value="True">
                                                        <Setter Property="Fill" Value="#00A352"/> <!-- Green -->
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <!-- Manifest Name & Game Count -->
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type lbTheme:Brushes}, ResourceId=ForegroundBrush}}" VerticalAlignment="Center">
                                        <Run Text="{Binding ManifestName}"/>
                                        <Run Text=" ("/>
                                        <Run Text="{Binding GameCount}"/>
                                        <Run Text=")"/>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Text="{Binding ValidationError}" FontSize="11" Foreground="#FF6B6B" Margin="18,2,0,0" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ValidationError}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <!-- Right: Sync Options Dropdown & Button -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="Sync:" Foreground="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type lbTheme:Brushes}, ResourceId=ForegroundBrush}}" Opacity="0.8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Width="160" Height="26" SelectedIndex="{Binding SelectedSyncIndex, Mode=TwoWay}" VerticalContentAlignment="Center" Margin="0,0,12,0" Background="#2B2B2B" Foreground="White" BorderBrush="#3F3F3F">
                                    <ComboBoxItem Content="Games Only"/>
                                    <ComboBoxItem Content="Media Only"/>
                                    <ComboBoxItem Content="Games &amp; Media"/>
                                </ComboBox>
                                <Button Content="Sync" Click="BtnRowSync_Click" Style="{StaticResource {ComponentResourceKey TypeInTargetAssembly={x:Type lbTheme:Styles}, ResourceId=AccentButton}}" Width="80" Height="26"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Bottom Action Panel -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Refresh Button -->
            <Button Grid.Column="1" Name="BtnRefresh" Click="BtnRefresh_Click" Width="120" Height="26" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Name="ImgBtnRefresh" Width="12" Height="12" Margin="0,1,6,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Refresh Config" Foreground="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type lbTheme:Brushes}, ResourceId=ForegroundBrush}}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Close Button (Red Vector Icon + Text) -->
            <Button Grid.Column="3" Name="BtnCancel" Click="BtnCancel_Click" Width="100" Height="26" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Red Cross Icon -->
                    <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="#FF3B30" StrokeThickness="2" Width="10" Height="10" Margin="0,1,6,0" SnapsToDevicePixels="True"/>
                    <TextBlock Text="Close" Foreground="{DynamicResource {ComponentResourceKey TypeInTargetAssembly={x:Type lbTheme:Brushes}, ResourceId=ForegroundBrush}}"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</lbThemeControls:ThemedWindow>
